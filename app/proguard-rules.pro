# No obfuscated name is relied upon, so the keep rules only cover:
#   - the Xposed metadata entry point generated by KSP
#   - payload, which calls host classes reflectively
#   - WCDB and MMKV are resolved at runtime inside the host process, so no keep is needed
-keep class io.github.ryf5584.wxdbdump.payload.** { *; }
-keep class io.github.ryf5584.wxdbdump.xposed.HookEntry* { *; }
-keep class io.github.ryf5584.wxdbdump.xposed.WcdbKeyHooks { *; }
-keep class io.github.ryf5584.wxdbdump.xposed.LoopbackServer { *; }
-keep class io.github.ryf5584.wxdbdump.xposed.WxDbEngine { *; }
-keep class io.github.ryf5584.wxdbdump.xposed.XposedHost { *; }
-keepclassmembers class * { @androidx.annotation.Keep *; }
-dontwarn com.tencent.**
-dontwarn de.robv.android.xposed.**
